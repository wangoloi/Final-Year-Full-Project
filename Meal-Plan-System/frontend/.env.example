# Meal Plan frontend (Vite)
# This app expects API calls to go through the Vite proxy at `/api` (see `vite.config.js`).
# Configure the proxy target with `MEAL_PLAN_API_PROXY` when running `npm run dev`:
#   $env:MEAL_PLAN_API_PROXY="http://127.0.0.1:8001"
#
# Optional: allow extra GlucoSense portal origins to postMessage JWT tokens into the iframe embed.
# Comma-separated full origins, e.g.:
# VITE_ALLOWED_GLUCOSENSE_ORIGINS=http://192.168.1.20:5173,https://portal.example.com
VITE_ALLOWED_GLUCOSENSE_ORIGINS=
